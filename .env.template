# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# M-Pesa / Safaricom Daraja — leave the credentials blank for demo mode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/mpesa/callback
MPESA_PAYBILL_DISPLAY=522533

# Demo data — seed refuses to run unless this is "true".
ALLOW_RESEED=false

# Sign-in codes — WhatsApp (Meta Cloud API), primary channel.
# Needs an approved *authentication* template with a copy-code button.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=mwandi_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# Sign-in codes — SMS fallback (Africa's Talking). Only used when WhatsApp is unset or fails.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=
