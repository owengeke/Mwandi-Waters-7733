# Copy to .env and fill in. Never commit real secrets.
# Local dev: DATABASE_URL=file:local.db (drizzle.local.config.ts handles file URLs).
# Vercel:   DATABASE_URL must point at a hosted libSQL/Turso database.

# ---------- App ----------
# Leave NODE_ENV unset on Vercel; set "development" only for local dev.
WEBSITE_URL=http://localhost:4200
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# ---------- Database (hosted libSQL / Turso) ----------
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=

# Local-only: read-only check of the hosted demo copy (bun run db:verify-hosted).
# The app itself uses DATABASE_URL / DATABASE_AUTH_TOKEN above.
HOSTED_DATABASE_URL=
HOSTED_DATABASE_AUTH_TOKEN=

# ---------- M-Pesa / Safaricom Daraja ----------
# Leave all five MPESA_* credentials empty to run the clearly labelled demo mode.
# Sandbox portal: https://developer.safaricom.co.ke  → Apps → your app → Keys
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill / shortcode that receives the STK Push (sandbox test shortcode: 174379)
MPESA_SHORTCODE=
# Lipa na M-Pesa Online passkey for that shortcode
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can reach, e.g. https://your-app.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/mpesa/callback
# Paybill number shown as the manual fallback under the pay button
MPESA_PAYBILL_DISPLAY=522533

# ---------- WhatsApp sign-in codes (Meta Cloud API) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=mwandi_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Invoice notice template (Meta → WhatsApp Manager → Message templates).
# Body must take eight variables, in this order:
#   {{1}} first name, {{2}} invoice number, {{3}} reading date,
#   {{4}} previous reading, {{5}} current reading, {{6}} units used,
#   {{7}} amount in KES, {{8}} due date.
# Without an approved template the notice is logged (demo mode) and issuing
# still succeeds.
WHATSAPP_INVOICE_TEMPLATE=
WHATSAPP_INVOICE_TEMPLATE_LANG=en

# ---------- SMS fallback (Africa's Talking) ----------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---------- Demo data ----------
# The seed script refuses to run unless this is exactly "true".
ALLOW_RESEED=false
